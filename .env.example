# Garmin Connect credentials (token file .garminconnect is auto-created on first login)
GARMIN_USER=
GARMIN_PASS=

# InfluxDB connection
INFLUX_HOST=localhost
INFLUX_PORT=8086
INFLUX_USER=
INFLUX_PASS=
INFLUX_DB=garmin

# Optional: date range for garmin-to-influxdb.py ingestion
START_DATE=2026-01-01
END_DATE=2026-12-31

# MCP server (inherited by container)
# INFLUX_HOST, INFLUX_PORT, INFLUX_USER, INFLUX_PASS, INFLUX_DB